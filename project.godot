gdscript/warnings/unsafe_cast=1
gdscript/warnings/unsafe_call_argument=1
gdscript/warnings/missing_await=1
gdscript/warnings/inference_on_variant=1
gdscript/warnings/native_method_override=1
gdscript/warnings/get_node_default_without_onready=1
gdscript/warnings/onready_with_export=1
gdscript/warnings/property_used_as_function=2
gdscript/warnings/constant_used_as_function=2
gdscript/warnings/function_used_as_property=2

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor]

